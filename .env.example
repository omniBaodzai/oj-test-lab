# Copy to .env (git-ignored) and fill in. NEVER commit real keys.
# Only OPENROUTER_* variables are read by OJ Test Lab.

# Required: create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required unless you pass --model. Calls are paid, so there is no default model.
# Example format: <vendor>/<model-name>  (see https://openrouter.ai/models)
OPENROUTER_MODEL=

# Optional (defaults shown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_OUTPUT_TOKENS=4000
OPENROUTER_MAX_RETRIES=2
